	(text_box "Power Switch\n\nSTSPIN32G4's min supply voltage is 5.5V, so need LM74502's turn-on threshold to be below that\n\nV_EN/UVLO = VM * [R2/(R1+R2)] === VM = V_EN/UVLO * [1+(R1/R2)]\n\nTyp vals from SNOSDE5A: V(EN_UVLOF)=1.14V, V(EN_UVLOR)=1.24V, I_EN/UVLO=3uA\n\nR1=31.5k (10k+21.5k) & R2=10k => 1+(R1/R2) = 4.15\n=> Voffset= R1 * I_EN/UVLO = 0.0945V\n=> VM_rising=5.24V, VM_failing=4.83V"
		(exclude_from_sim no)
		(at 208.28 25.4 0)
		(size 70.358 30.5285)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ab94e564-0f2e-4a02-ae24-a1e01252cfe9")
	)
