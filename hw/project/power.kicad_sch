			)
			(justify left top)
		)
		(uuid "4c23f8ee-5a4e-4d35-9687-45e4c99f5bcd")
	)
	(text_box "TVS Diode OVP\n- PMOS has V_DS(max)=60V, so V_C=59.3V<60V\n- V_spec(max)=36V, so V_wm=36.8V>36V"
		(exclude_from_sim no)
		(at 22.86 71.12 0)
		(size 50.8 10.16)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "7def7196-4272-43af-9cab-1d24feed1e78")
	)
	(text_box "High-side PMOS RPP\n- PMOS has R_DS(on,min) = 0.0053 Ohms @ -10V and V_GS(max)=+/-20V, so V_Z=12V\n- tau(max) = R_pd*C_iss(max) = 118 kOhms*9800 pF (typ) = 1.16ms < 27.1ms"
		(exclude_from_sim no)
		(at 73.66 71.12 0)
		(size 91.44 10.16)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "86f4c720-e9b8-447e-a1c5-3dbacc1b494d")
	)
	(text_box "Power on PMOS' Zener Diode and Pull-down Resistor\n- P_Z = V_Z*I_pd = 12V * 203.4uA = 2.44mW < 500mW\n- V_G = V_bus−V_Z = 36−12 = 24V. I_pd = 24V/118kOhms = 203.4uA. \n- P_pd = V_G*I_pd = 24V*203.4 uA = 4.88mW < 0.1W"
		(exclude_from_sim no)
		(at 205.74 71.12 0)
		(size 76.2 10.16)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "aa5ed0fe-9579-4a8d-a681-4a3e7fc1231b")
	)
	(text_box "Absolute Maximum Ratings\n- Supply Voltage: 36V. Continuous Current: 15A. Worst Load: 36V, 250W E-bike Motor."
		(exclude_from_sim no)
		(at 190.5 20.32 0)
		(size 91.44 7.6199)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "c04b1b9c-4945-4484-9665-edb560f13562")
	)
	(text_box "Bulk Capacitor Bank\n- C_bulk(min) = [I(max)*D(1−D)]/(f_sw*deltaV_ripple(target)) = (15*0.25)/(20000*0.36) = 3.75/7200 = 520.8uF\n- I_ripple(total) > I(max)*sqrt[D(1−D)] = 15*sqrt(0.25) = 7.5A_rms => I_ripple(single) > 7.5/3 = 2.5A_rms\n\n- C_total = 3*430uF = 1290uF. ESR_total = 31mOhms/3 = 10.33mOhms (in parallel, 100kHz/20°C)\n- coefficient_log-interpolated(20 kHz) = 0.958 => I_ripple(single) = 4.61*0.958 = 4.42A_rms @ 20kHz => I_ripple(total) = 3*4.42 = 13.25A_rms @ 20kHz\n- E = 0.5*C*V^2 = 0.5*1290uF*36^2 = 0.836 J\n\n- I_bleed = 36V / 44.2kOhms = 814.5uA => P_bleed(single) = 18V*814.5uA = 14.66mW\n- tau_bleed = R_total × C_total = 44.2kOhms× 1290uF = 57.0s\n\n- T_a=70°C: T_J=150.7°C, R_DS(on)=8.96mOhms, P=2.02W => 24.3°C to 175°C(max)"
		(exclude_from_sim no)
		(at 190.5 27.94 0)
		(size 91.44 35.56)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "f3d4192a-b2c7-481b-801c-d0729d43b710")
	)
