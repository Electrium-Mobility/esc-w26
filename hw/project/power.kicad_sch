	(text_box "RC Soft-Start\ntau(typ) = R_pd*[C_ss+C_iss(typ)] = 118kΩ*(220nF+7.5nF) = 26.8ms > 1.16ms"
		(exclude_from_sim no)
		(at 165.1 71.12 0)
		(size 40.64 10.16)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
