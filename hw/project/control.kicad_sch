		(uuid "d4ee9a4c-5bc9-4180-9ec1-5bee62498a6c")
	)
	(text_box "Reset and Boot Buttons\n\nExposing switch to drive BOOT0 to recover MCU in case of flashing issues"
		(exclude_from_sim no)
		(at 236.22 12.7 0)
