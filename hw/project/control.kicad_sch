	(text_box "V_DS Monitoring Protection / Short Circuit REFerence (5.2.5)\n\n- Normally Open, so feature enabled when header is NOT on\n- Capacitor is N.M. There in case of false positives.\n\nResistor divider based on EVSPIN32G4's use of the STL110N10F7, so need to spec for desired trip current since same MOSFETs are used\n\nRefer to J2 and section 5.5.1 in UM2896"
		(exclude_from_sim no)
		(at 210.82 91.44 0)
		(size 71.12 21.5899)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "5e44799f-f670-4a3c-8efe-b8cf5f4148cc")
	)
	(text_box "Internal 3.3V Linear Regulator\n\nEnabled (5.1.2), VCC-REGIN jumper for external VCC cfg\n"
		(exclude_from_sim no)
		(at 236.22 68.58 0)
		(size 45.72 11.43)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "63a41657-c2aa-401b-8fb3-b2980d0326b4")
	)
	(text_box "Internal VCC Buck Regulator\n\nEnabled (5.1.1), value configured in FW (\"Disabled\" cfg not implemented)"
		(exclude_from_sim no)
		(at 236.22 55.88 0)
		(size 45.72 12.7)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "6a8062a1-72d8-45b4-9140-244cc6d76dd2")
	)
	(text_box "Temperature Monitoring (placed near MOSFETs/Power and for ESC PCB, not the Motor)\n\n- 10k NTC is standard, but is taken at 25 deg C. \n- Since active operation temp > room temp, use R_bias = 4.7k to shift ADC midpoint (1.65V) over active temp range (check datasheet for when R_NTC drops to 4.7k exactly)\n- NCU18XH103F60RB matches beta_25/100 = 3455 K from section 5.8 (UM2896). Refer to the graph."
		(exclude_from_sim no)
		(at 177.8 147.32 0)
		(size 104.14 14.1714)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(face "KiCad Font")
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b2aecc59-5b9d-4b54-a872-c103a2051078")
	)
	(text_box "ADC Positive Reference Voltage\n\n- EVSPIN32G4 uses VREF+ instead of VDD on the temp sense and current sense dividers, but we should never use VREF+(?)\n- Only use VDDA for devices that need a low noise power source\n- Note: No ferrite bead in between VDD and VDDA. VDD shorted to VDDA, VDDA shorted to VREF+."
		(exclude_from_sim no)
		(at 236.22 29.21 0)
		(size 45.72 24.13)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bf906a37-66e2-46a3-a9d3-c5748c3e9b81")
	)
	(text_box "Ext. Oscillator\n\nR_ext=0 fine since STM32G4 has a low drive level"
		(exclude_from_sim no)
		(at 91.44 185.4199 0)
		(size 83.82 10.16)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
