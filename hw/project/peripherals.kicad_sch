			)
			(justify left top)
		)
		(uuid "6841050d-9026-4a68-97e2-30ab89861a9d")
	)
	(text_box "Phase Outputs\n- High-power screw terminal block (Max 58A, 300V)\n- Expects either raw wire or terminal connector tabs crimped on the wire across 6-20 AWG"
		(exclude_from_sim no)
		(at 99.06 33.02 0)
		(size 68.58 15.24)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
