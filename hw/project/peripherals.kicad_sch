				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "671752fe-1c24-4858-aa49-3ccf7df1dc38")
	)
	(text_box "2.54 Comm (2.54mm Pitch Header)\n\nSerial and ADC exposed twice (once with their own JST connectors, and another while combined with regular male pins)\n\nFor debugging"
		(exclude_from_sim no)
		(at 213.36 114.3 0)
		(size 23.114 30.48)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
