		(uuid "aa919859-994f-4f30-bc1b-c28e2908e2ff")
	)
	(text_box "Throttle (JST-XH)\n\n- Uses ADC2 or ADC12_IN7 (PC1)\n- For bike's thumb throttle (wire cut off & stripped)\n- Expects 5V ADC for full range\n- Can also use an external pot"
		(exclude_from_sim no)
		(at 218.44 50.8 0)
		(size 17.78 33.0199)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
