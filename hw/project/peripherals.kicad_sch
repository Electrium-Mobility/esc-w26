	)
	(text_box "Battery Input\n- High-power screw terminal block (Max 58A, 300V)\n- Expects either raw wire or terminal connector tabs crimped on the wire across 6-20 AWG\n- User will need to hook up an adapter to the connector used by the battery"
		(exclude_from_sim no)
		(at 99.06 17.78 0)
